<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="../../Backend/queue-actions.php"
         colors="true" cacheDirectory="../../build/queue-phpunit-cache">
    <testsuites>
        <testsuite name="queue-unit">
            <file>QueueValidationTest.php</file>
        </testsuite>
        <testsuite name="queue-mysql">
            <file>QueueActionsDatabaseTest.php</file>
        </testsuite>
        <testsuite name="queue-endpoints">
            <file>JoinQueueEndpointTest.php</file>
            <file>LeaveQueueEndpointTest.php</file>
            <file>CurrentQueueEndpointTest.php</file>
            <file>QueueEntryPointTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <file>../../Backend/queue-actions.php</file>
            <file>../../Backend/join-queue-request.php</file>
            <file>../../Backend/join-queue.php</file>
            <file>../../Backend/leave-queue-request.php</file>
            <file>../../Backend/leave-queue.php</file>
            <file>../../Backend/current-queue-request.php</file>
            <file>../../Backend/current-queue.php</file>
        </include>
    </source>
</phpunit>
